# Copy this file to .env (never commit .env).
# Local Supabase: run `supabase status` and paste the API URL and anon key.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=

# C8 (server only, never PUBLIC_): service role key (`supabase status` -> SERVICE_ROLE_KEY) and the
# single super admin, created at server start if missing. Leave empty to skip the bootstrap.
SUPABASE_SERVICE_ROLE_KEY=
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
