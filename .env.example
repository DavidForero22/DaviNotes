# Copy this file to .env and fill it in (never commit .env).
# Values for the local stack: start it with `npx supabase start`, then run
# `npx supabase status -o env` and copy the variables named below.
# Restart `npm run dev` after changing this file.

# --- Public (sent to the browser) --------------------------------------------
# API_URL from `supabase status -o env` (port [api] in supabase/config.toml).
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# ANON_KEY from `supabase status -o env` ("Publishable key" in the plain `supabase status` output).
PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never prefix with PUBLIC_) ---------------------------------
# SERVICE_ROLE_KEY from `supabase status -o env` ("Secret key" in the plain output).
# Bypasses RLS: needed by the admin panel and the super admin bootstrap.
SUPABASE_SERVICE_ROLE_KEY=

# Single super admin, created (or promoted, if the email already exists) on the first
# server-rendered request. Leave EMAIL or PASSWORD empty to skip the bootstrap.
# Password: at least 8 characters. NAME is optional (max 40 characters).
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
