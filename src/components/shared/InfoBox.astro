---
import type { DifficultyLevel } from "@/data/languages";
import type { Lang, Localized } from "@/i18n/ui";
import { pick, useTranslations } from "@/i18n/utils";
import DifficultyBadge from "@/components/shared/DifficultyBadge.astro";

interface Props {
	lang: Lang;
	difficulty: DifficultyLevel | undefined;
	prerequisites?: Localized[];
}

const { lang, difficulty, prerequisites } = Astro.props;
const t = useTranslations(lang);
---

<div class="info-box">
	<div class="info-item">
		<span class="label">{t("info.difficulty")}</span>
		{difficulty && <DifficultyBadge lang={lang} difficulty={difficulty} />}
	</div>

	{
		prerequisites && (
			<div class="info-item">
				<span class="label">{t("info.prerequisites")}</span>
				<div class="prereq-tags">
					{prerequisites.map((req) => (
						<span class="tag">{pick(req, lang).trim()}</span>
					))}
				</div>
			</div>
		)
	}
</div>

<style>
	.info-box {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 8px;
		padding: 1rem 1.5rem;
		margin-top: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.info-item {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.label {
		font-weight: 600;
		color: #e0e0e0;
		font-size: 0.9rem;
		min-width: 100px;
	}

	.prereq-tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.tag {
		background: #23262d;
		color: #a1a1aa;
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		font-size: 0.85rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	@media (min-width: 600px) {
		.info-box {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
	}
</style>
