---
import HomeLayout from "@/layouts/home/HomeLayout.astro";
import LanguageCard from "@/components/docs/LanguageCard.astro";
import LanguagePicker from "@/components/shared/LanguagePicker.astro";
import "@/styles/global.css";
import { languages } from "@/data/languages";
import type { Lang } from "@/i18n/ui";
import { pick, useTranslations } from "@/i18n/utils";
import { getSortedCategories, languageHref } from "@/utils/utils";
import HelpModal from "@/components/shared/HelpModal.astro";
import ModeSwitch from "@/components/shared/ModeSwitch.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const sortedLanguages = getSortedCategories(languages);
---

<HomeLayout title="DaviNotes" lang={lang}>
	<div
		class="home-top-bar"
		style="display: flex; gap: 0.75rem; align-items: center;"
	>
		<ModeSwitch lang={lang} mode="docs" />
		<HelpModal lang={lang} />
		<LanguagePicker lang={lang} />
	</div>

	<header class="hero">
		<h1>Davi<span class="text-gradient">Notes</span></h1>
		<p class="subtitle">{t("home.subtitle")}</p>
	</header>

	{
		sortedLanguages.map((section) => (
			<section class="tech-section">
				<h2 class="section-title">{pick(section.category, lang)}</h2>
				<hr />

				<div class="link-card-grid">
					{section.items.map((item) => (
						<LanguageCard
							href={languageHref(item, lang)}
							title={item.title}
							description={pick(item.desc, lang)}
							color={item.color}
							icon={item.icon}
						/>
					))}
				</div>
			</section>
		))
	}
</HomeLayout>
