---
import LearnLayout from "@/layouts/learn/LearnLayout.astro";
import type { Lang, UIKey } from "@/i18n/ui";
import { localizePath, useTranslations } from "@/i18n/utils";
import { DISPLAY_NAME_MAX_LENGTH, EMAIL_MAX_LENGTH, PASSWORD_MAX_LENGTH, PASSWORD_MIN_LENGTH } from "@/lib/auth-rules";
import type { AuthField, AuthFieldError, AuthFlash } from "@/types/api";

interface Props {
	lang: Lang;
	page: "login" | "register";
	/** Errors and typed values of the last failed POST (`consumeAuthFlash`, read by the page). */
	flash: AuthFlash | null;
}

/**
 * Sign-in and sign-up form (T13, guide account-a11y §1). Plain `<form method="post">` to
 * `/api/auth/*`: works the same with and without JavaScript (`data-astro-reload`), and every
 * error comes from the server (`novalidate`) through the flash cookie after the 303.
 */
const { lang, page, flash } = Astro.props;
const t = useTranslations(lang);
const isRegister = page === "register";
const errors = flash?.errors ?? [];
const values = flash?.values ?? {};

/** `next` is only echoed back; `/api/auth/*` validates it again (`safeNext`). */
const rawNext = Astro.url.searchParams.get("next");
const next = rawNext && rawNext.startsWith("/") && !rawNext.startsWith("//") && !rawNext.startsWith("/\\") ? rawNext : "";
const withNext = (path: string) => (next ? `${path}?next=${encodeURIComponent(next)}` : path);
const loginHref = withNext(localizePath("/learn/login", lang));
const otherHref = withNext(localizePath(isRegister ? "/learn/login" : "/learn/register", lang));

// ---------------------------------------------------------------- error texts (§1.5)

interface ShownError {
	/** id of the field the summary links to. */
	target: AuthField;
	/** Field that gets aria-invalid and the inline message, if any. */
	field?: AuthField;
	/** Plain text (summary and inline). */
	text: string;
	/** email_taken: inline text around a link to sign in. */
	signInLink?: { before: string; label: string; after: string };
}

const fill = (key: UIKey, vars: Record<string, string | number>) =>
	t(key, Object.fromEntries(Object.entries(vars).map(([k, v]) => [k, String(v)])));

function describe(error: AuthFieldError): ShownError {
	switch (error.code) {
		case "invalid_input":
			if (error.field === "email") {
				return { target: "email", field: "email", text: t(values.email ? "auth.error.emailInvalid" : "auth.error.emailEmpty") };
			}
			if (error.field === "password") {
				return { target: "password", field: "password", text: fill("auth.error.passwordInvalid", { max: PASSWORD_MAX_LENGTH }) };
			}
			if (error.field === "displayName") {
				return {
					target: "displayName",
					field: "displayName",
					text: fill("auth.error.displayNameInvalid", { max: DISPLAY_NAME_MAX_LENGTH }),
				};
			}
			break;
		case "weak_password":
			return { target: "password", field: "password", text: fill("auth.error.weakPassword", { min: PASSWORD_MIN_LENGTH }) };
		case "email_taken": {
			const label = t("auth.error.emailTakenLink");
			const [before = "", after = ""] = t("auth.error.emailTaken").split("{signIn}");
			return { target: "email", field: "email", text: `${before}${label}${after}`, signInLink: { before, label, after } };
		}
		case "invalid_credentials":
			// Never says which field failed: no aria-invalid (guide §1.5)
			return { target: "email", text: t("auth.error.invalidCredentials") };
		case "rate_limited":
			return { target: "email", text: t("auth.error.rateLimited") };
	}
	// internal_error and anything unknown: the page is never left without a message
	return { target: "email", text: t("auth.error.internal") };
}

const shown = errors.map(describe);
const byField = (field: AuthField) => shown.find((error) => error.field === field);
const emailError = byField("email");
const passwordError = byField("password");
const nameError = isRegister ? byField("displayName") : undefined;

const plural = new Intl.PluralRules(lang);
const summaryTitle = plural.select(shown.length) === "one"
	? t("auth.errorSummary.one")
	: fill("auth.errorSummary.other", { count: shown.length });

const heading = t(isRegister ? "auth.register.title" : "auth.login.title");
const pageTitle = `${heading} · DaviLearn`;
const title = shown.length > 0 ? t("auth.errorTitle", { title: pageTitle }) : pageTitle;

const passwordHintId = "password-hint";
const describedBy = (...ids: (string | false | undefined)[]) => ids.filter(Boolean).join(" ") || undefined;
---

<LearnLayout
	title={title}
	lang={lang}
	description={t(isRegister ? "auth.register.description" : "auth.login.description")}
	noindex
>
	<div class="auth">
		<h1>{heading}</h1>

		{
			next && (
				<p class="auth-notice">
					<svg class="auth-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<rect x="5" y="11" width="14" height="10" rx="2" />
						<path d="M8 11V8a4 4 0 0 1 8 0v3" />
					</svg>
					{t("auth.continueNotice")}
				</p>
			)
		}

		{
			shown.length > 0 && (
				<div class="error-summary" tabindex="-1" autofocus aria-labelledby="error-summary-title">
					<h2 id="error-summary-title">
						<svg class="auth-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<circle cx="12" cy="12" r="9" />
							<path d="M12 7.5v5.5M12 16.5v.01" />
						</svg>
						{summaryTitle}
					</h2>
					<ul>
						{shown.map((error) => (
							<li>
								<a href={`#${error.target}`}>{error.text}</a>
							</li>
						))}
					</ul>
				</div>
			)
		}

		<form method="post" action={`/api/auth/${page}`} novalidate data-astro-reload class="auth-form">
			<input type="hidden" name="lang" value={lang} />
			{next && <input type="hidden" name="next" value={next} />}

			{isRegister && <p class="form-note">{t("auth.requiredNote")}</p>}

			<div class:list={["field", { "field--invalid": emailError }]}>
				<label for="email">{t("auth.email.label")}</label>
				{
					emailError && (
						<p id="email-error" class="field-error">
							<svg class="auth-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<circle cx="12" cy="12" r="9" />
								<path d="M9 9l6 6M15 9l-6 6" />
							</svg>
							<span>
								<span class="sr-only">{t("auth.errorPrefix")} </span>
								{emailError.signInLink ? (
									<Fragment>
										{emailError.signInLink.before}
										<a href={loginHref}>{emailError.signInLink.label}</a>
										{emailError.signInLink.after}
									</Fragment>
								) : (
									emailError.text
								)}
							</span>
						</p>
					)
				}
				<input
					id="email"
					name="email"
					type="email"
					autocomplete="email"
					required
					spellcheck="false"
					autocapitalize="none"
					maxlength={EMAIL_MAX_LENGTH}
					value={values.email}
					aria-invalid={emailError ? "true" : undefined}
					aria-describedby={describedBy(emailError && "email-error")}
				/>
			</div>

			<div class:list={["field", { "field--invalid": passwordError }]}>
				<label for="password">{t("auth.password.label")}</label>
				{isRegister && <p id={passwordHintId} class="field-hint">{t("auth.password.hint", { min: String(PASSWORD_MIN_LENGTH) })}</p>}
				{
					passwordError && (
						<p id="password-error" class="field-error">
							<svg class="auth-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<circle cx="12" cy="12" r="9" />
								<path d="M9 9l6 6M15 9l-6 6" />
							</svg>
							<span>
								<span class="sr-only">{t("auth.errorPrefix")} </span>
								{passwordError.text}
							</span>
						</p>
					)
				}
				<div class="password-wrap">
					<input
						id="password"
						name="password"
						type="password"
						data-password
						autocomplete={isRegister ? "new-password" : "current-password"}
						required
						maxlength={PASSWORD_MAX_LENGTH}
						aria-invalid={passwordError ? "true" : undefined}
						aria-describedby={describedBy(passwordError && "password-error", isRegister && passwordHintId)}
					/>
					{/* Shown by the script: without JavaScript it would do nothing (guide §1.4) */}
					<button type="button" class="password-toggle" aria-controls="password" aria-pressed="false" hidden>
						<svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" />
							<circle cx="12" cy="12" r="3" />
						</svg>
						<svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path d="M3 3l18 18M10.6 5.6A10 10 0 0 1 12 5.5c6 0 9.5 6.5 9.5 6.5a17 17 0 0 1-3 3.7M6.6 6.6A16.6 16.6 0 0 0 2.5 12S6 18.5 12 18.5a9.6 9.6 0 0 0 4.4-1.1M9.9 9.9a3 3 0 0 0 4.2 4.2" />
						</svg>
						<span class="sr-only">{t("auth.password.show")}</span>
					</button>
				</div>
			</div>

			{
				isRegister && (
					<div class:list={["field", { "field--invalid": nameError }]}>
						<label for="displayName">{t("auth.displayName.label")}</label>
						<p id="displayName-hint" class="field-hint">
							{t("auth.displayName.hint", { max: String(DISPLAY_NAME_MAX_LENGTH) })}
						</p>
						{nameError && (
							<p id="displayName-error" class="field-error">
								<svg class="auth-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
									<circle cx="12" cy="12" r="9" />
									<path d="M9 9l6 6M15 9l-6 6" />
								</svg>
								<span>
									<span class="sr-only">{t("auth.errorPrefix")} </span>
									{nameError.text}
								</span>
							</p>
						)}
						<input
							id="displayName"
							name="displayName"
							type="text"
							autocomplete="nickname"
							value={values.displayName}
							aria-invalid={nameError ? "true" : undefined}
							aria-describedby={describedBy(nameError && "displayName-error", "displayName-hint")}
						/>
					</div>
				)
			}

			<button type="submit" class="auth-submit">{t(isRegister ? "auth.register.submit" : "auth.login.submit")}</button>
		</form>

		<p class="auth-switch">
			{t(isRegister ? "auth.register.switchPrompt" : "auth.login.switchPrompt")}
			<a href={otherHref}>{t(isRegister ? "auth.register.switchLink" : "auth.login.switchLink")}</a>
		</p>
	</div>
</LearnLayout>

<script>
	/** Shows the password toggles and puts the focus on the error summary (guide §1.4, §1.5). */
	document.addEventListener("astro:page-load", () => {
		document.querySelectorAll<HTMLButtonElement>(".password-toggle").forEach((button) => {
			button.hidden = false;
		});
		const summary = document.querySelector<HTMLElement>(".error-summary");
		if (summary && document.activeElement !== summary) summary.focus();
	});

	document.addEventListener("click", (event) => {
		const target = event.target instanceof Element ? event.target : null;

		// Show or hide the password: only `type` and `aria-pressed` change; focus stays on the button
		const toggle = target?.closest<HTMLButtonElement>(".password-toggle");
		if (toggle) {
			const input = document.getElementById(toggle.getAttribute("aria-controls") ?? "");
			if (!(input instanceof HTMLInputElement)) return;
			const show = input.type === "password";
			input.type = show ? "text" : "password";
			toggle.setAttribute("aria-pressed", String(show));
			return;
		}

		// Summary links: focus the field and keep its label in view
		const link = target?.closest<HTMLAnchorElement>(".error-summary a[href^='#']");
		if (link) {
			const id = link.hash.slice(1);
			const input = document.getElementById(id);
			if (!input) return;
			event.preventDefault();
			const label = document.querySelector(`label[for="${CSS.escape(id)}"]`);
			(label ?? input).scrollIntoView({ block: "center" });
			input.focus({ preventScroll: true });
		}
	});

	/** The password goes back to type="password" before sending, so it is never saved as plain text. */
	document.addEventListener("submit", (event) => {
		const form = event.target;
		if (!(form instanceof HTMLFormElement)) return;
		form.querySelectorAll<HTMLInputElement>("input[data-password]").forEach((input) => {
			input.type = "password";
		});
		form.querySelectorAll<HTMLButtonElement>(".password-toggle").forEach((button) => {
			button.setAttribute("aria-pressed", "false");
		});
	});
</script>

<style>
	.auth {
		width: 100%;
		max-width: 26rem;
		margin: 0 auto;
		text-align: start;
	}

	.auth h1 {
		margin-bottom: 1.5rem;
		font-size: 2.6rem;
	}

	.auth-icon {
		width: 1.15em;
		height: 1.15em;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* ---------- "Sign in to continue" (content, not a live region: guide §3.5) ---------- */
	.auth-notice {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: -0.5rem 0 1.5rem;
		color: var(--text-secondary);
		font-size: 1rem;
	}

	.auth-notice .auth-icon {
		color: var(--brand);
	}

	/* ---------- Error summary ---------- */
	.error-summary {
		margin: 0 0 1.75rem;
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--error);
		border-radius: 14px;
		background: var(--error-bg);
	}

	.error-summary:focus-visible,
	.error-summary:focus {
		outline: 2px solid var(--focus-ring);
		outline-offset: 3px;
	}

	.error-summary h2 {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0 0 0.6rem;
		color: var(--error);
		font-size: 1.1rem;
	}

	.error-summary ul {
		display: grid;
		gap: 0.4rem;
		margin: 0;
		padding-left: 1.75rem;
		color: var(--text-secondary);
	}

	.error-summary a {
		color: var(--text-color);
		line-height: 1.5;
		text-decoration: underline;
		text-decoration-color: var(--error);
		text-underline-offset: 3px;
	}

	.error-summary a:hover {
		text-decoration-thickness: 2px;
	}

	/* ---------- Form ---------- */
	.auth-form {
		display: grid;
		gap: 1.35rem;
	}

	.form-note {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.92rem;
	}

	.field {
		display: grid;
		gap: 0.4rem;
	}

	.field label {
		color: var(--text-color);
		font-size: 0.95rem;
		font-weight: 700;
	}

	.field-hint {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.88rem;
		line-height: 1.45;
	}

	.field-error {
		display: flex;
		align-items: flex-start;
		gap: 0.45rem;
		margin: 0;
		color: var(--error);
		font-size: 0.92rem;
		font-weight: 600;
		line-height: 1.45;
	}

	.field-error .auth-icon {
		margin-top: 0.1rem;
	}

	.field-error a {
		color: var(--text-color);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.field input {
		width: 100%;
		min-height: 3rem;
		box-sizing: border-box;
		padding: 0.6rem 1rem;
		border: 1px solid var(--text-subtle);
		border-radius: 12px;
		background: var(--surface-deep);
		color: var(--text-color);
		caret-color: var(--brand);
		font: inherit;
		font-size: 1rem;
		transition: border-color 0.15s ease;
	}

	.field input:hover {
		border-color: var(--text-muted);
	}

	.field input:focus-visible {
		border-color: var(--brand);
		outline: 2px solid var(--focus-ring);
		outline-offset: 1px;
	}

	/* 2px border in the error color: 3:1 against the page and the field (guide §1.5) */
	.field--invalid input {
		border-color: var(--error);
		box-shadow: inset 0 0 0 1px var(--error);
	}

	/* Autofill keeps the dark field instead of the browser's yellow */
	.field input:-webkit-autofill {
		-webkit-text-fill-color: var(--text-color);
		box-shadow: inset 0 0 0 100px var(--surface-sunken);
	}

	.password-wrap {
		position: relative;
	}

	.password-wrap input {
		padding-right: 3.25rem;
	}

	/* Inside the field, after it in the DOM (tab order: field, then button) */
	.password-toggle {
		position: absolute;
		top: 50%;
		right: 0.3rem;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: 0;
		border-radius: 9px;
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
		transform: translateY(-50%);
	}

	.password-toggle[hidden] {
		display: none;
	}

	.password-toggle:hover {
		background: var(--surface-sunken);
		color: var(--text-color);
	}

	.password-toggle svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.password-toggle .eye-closed,
	.password-toggle[aria-pressed="true"] .eye-open {
		display: none;
	}

	.password-toggle[aria-pressed="true"] .eye-closed {
		display: block;
	}

	.password-toggle[aria-pressed="true"] {
		color: var(--brand);
	}

	.auth-submit {
		min-height: 3rem;
		margin-top: 0.35rem;
		padding: 0.6rem 1.6rem;
		border: none;
		border-radius: 99px;
		background: var(--brand);
		color: var(--on-brand);
		font: inherit;
		font-size: 1.02rem;
		font-weight: 800;
		cursor: pointer;
		transition:
			background 0.15s ease,
			transform 0.1s ease;
	}

	.auth-submit:hover {
		background: var(--brand-hover);
	}

	.auth-submit:active {
		transform: scale(0.98);
	}

	.auth-switch {
		margin: 2rem 0 0;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		color: var(--text-muted);
	}

	.auth-switch a {
		margin-left: 0.3rem;
		color: var(--brand);
		font-weight: 700;
		text-underline-offset: 3px;
	}

	.auth-switch a:hover {
		color: var(--brand-hover);
	}

	@media (max-width: 846px) {
		.auth h1 {
			font-size: 2.1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.field input,
		.auth-submit {
			transition: none;
		}
	}
</style>
