---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

/**
 * Shown instead of `NextLesson` at the bottom of a language's very last guide, when that
 * language has at least one framework in `data/frameworks.ts`. Links back to the "Frameworks"
 * section of the language's landing page.
 */
interface Props {
	lang: Lang;
	href: string;
	languageName: string;
}

const { lang, href, languageName } = Astro.props;
const t = useTranslations(lang);
---

<nav class="discover-frameworks">
	<a href={href} title={t("doc.discoverFrameworksTitle", { lang: languageName })}>
		<span class="label">{t("doc.discoverFrameworks")}</span>
		<span class="lesson">{t("doc.discoverFrameworksCta", { lang: languageName })} <span class="arrow">&rarr;</span></span>
	</a>
</nav>

<style>
	.discover-frameworks {
		display: flex;
		justify-content: flex-end;
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.discover-frameworks a {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.25rem;
		min-width: min(100%, 280px);
		padding: 1rem 1.5rem;
		background: #1e2127;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 8px;
		text-decoration: none;
		transition: transform 0.2s, border-color 0.2s;
	}

	.discover-frameworks a:hover {
		transform: translateY(-3px);
		border-color: #a78bfa;
	}

	.label {
		color: #888;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.lesson {
		color: white;
		font-size: 1.1rem;
		font-weight: bold;
	}

	.arrow {
		color: #a78bfa;
		transition: margin-left 0.2s;
	}

	.discover-frameworks a:hover .arrow {
		margin-left: 0.25rem;
	}
</style>
