---
import HomeLayout from "../layouts/HomeLayout.astro";
import "../styles/global.css";
import { defaultLang } from "../i18n/ui";
import { langs, localizePath, useTranslations } from "../i18n/utils";

/**
 * Hosting services serve a single 404.html for every missing URL, so the page is
 * rendered in the default language and carries the other translations as data.
 * A small script swaps the texts when the missing URL starts with a language prefix.
 */
const t = useTranslations(defaultLang);
const translations = Object.fromEntries(
	langs.map((code) => {
		const tr = useTranslations(code);
		return [
			code,
			{
				title: tr("404.title"),
				subtitle: tr("404.subtitle"),
				description: tr("404.description"),
				home: tr("404.home"),
				homeHref: localizePath("/", code),
			},
		];
	}),
);
---

<HomeLayout title={t("404.title")} lang={defaultLang} alternates={false}>
	<div class="error-container" data-translations={JSON.stringify(translations)}>
		<div class="content">
			<h1 class="error-code">4<span class="text-gradient">0</span>4</h1>

			<h2 class="subtitle" data-i18n="subtitle">{t("404.subtitle")}</h2>

			<div class="terminal-box">
				<div class="dots">
					<span></span><span></span><span></span>
				</div>
				<p class="description" data-i18n="description">
					{t("404.description")}
				</p>
			</div>

			<a href="/" class="home-btn" data-i18n="home">{t("404.home")}</a>
		</div>
	</div>
</HomeLayout>

<script>
	document.addEventListener("astro:page-load", () => {
		const container = document.querySelector<HTMLElement>(".error-container");
		if (!container?.dataset.translations) return;

		const translations = JSON.parse(container.dataset.translations);
		const [, prefix] = window.location.pathname.split("/");
		const texts = translations[prefix];
		if (!texts) return;

		document.documentElement.lang = prefix;
		document.title = texts.title;
		container.querySelectorAll<HTMLElement>("[data-i18n]").forEach((element) => {
			element.textContent = texts[element.dataset.i18n!];
		});
		container.querySelector<HTMLAnchorElement>(".home-btn")!.href = texts.homeHref;
	});
</script>

<style>
/* =========================================
    Layout & Main Container
   ========================================= */
.error-container {
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 2rem;
}

.content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
  max-width: 600px;
}

/* =========================================
    Typography & Text Styles
   ========================================= */
.error-code {
  font-size: 8rem;
  font-weight: 800;
  line-height: 1;
  margin: 0;
  color: white;
  text-shadow: 0 0 30px rgba(167, 139, 250, 0.2);
}

.subtitle {
  font-size: 2rem;
  margin: 0;
  color: white;
}

.description {
  font-size: 1.1rem;
  color: #a1a1aa;
  line-height: 1.6;
}

/* =========================================
    Terminal Decoration Component
   ========================================= */
.terminal-box {
  background: #1e2127;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  padding: 1.5rem 2rem;
  margin: 2rem 0;
  width: 100%;
  max-width: 400px;
  text-align: left;
  font-family: monospace;
  position: relative;
  box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
}

.dots {
  position: absolute;
  top: 12px;
  left: 12px;
  display: flex;
  gap: 6px;
}

.dots span {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
}

/* =========================================
    Navigation & Buttons
   ========================================= */
.home-btn {
  display: inline-block;
  background-color: white;
  color: black;
  padding: 0.75rem 2rem;
  border-radius: 99px;
  font-weight: bold;
  text-decoration: none;
  transition: 0.2s;
}

.home-btn:hover {
  transform: scale(1.05);
  background-color: #e4e4e7;
}
</style>
