---
import AdminExercises from "@/components/admin/AdminExercises.vue";
import AdminLayout from "@/layouts/admin/AdminLayout.astro";
import { adminGuard, adminLoginHref } from "./_guard";
import { loadExerciseCatalog } from "./_catalog";

/**
 * /admin/exercises — exercises of the admin panel (C8). Server-rendered, `noindex`, same guard
 * as the users page. The page reads the catalog (languages, frameworks, concepts, categories)
 * for the filters and the form; the `AdminExercises` island talks to `/api/admin/exercises`.
 */
export const prerender = false;

const user = adminGuard(Astro);
if (user instanceof Response) return user;
const catalog = await loadExerciseCatalog(Astro.locals.supabase);
const loginHref = adminLoginHref("/admin/exercises");
---

<AdminLayout title="Ejercicios" section="exercises">
	<div class="admin-page-head">
		<h1>Ejercicios</h1>
		<p class="admin-lede">Crea, corrige y ordena los ejercicios de DaviLearn: enunciado, respuesta y pistas.</p>
	</div>
	<AdminExercises client:load catalog={catalog} loginHref={loginHref} />
</AdminLayout>
