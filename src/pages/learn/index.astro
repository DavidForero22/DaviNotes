---
import LearnHome from "@/components/learn/LearnHome.astro";
import { defaultLang } from "@/i18n/ui";
import { loadLearnHome } from "./_exercises";

/**
 * /learn — the learning area in the default language, served without a prefix like the
 * documentation. Server-rendered (T14) so the header, the roulette and the list follow the
 * session. Other languages: `pages/[lang]/learn/index.astro`.
 */
export const prerender = false;

const data = await loadLearnHome(Astro.locals.supabase, Astro.locals.user, defaultLang);
---

<LearnHome lang={defaultLang} {...data} />
