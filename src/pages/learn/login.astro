---
import AuthForm from "@/components/learn/AuthForm.astro";
import { defaultLang } from "@/i18n/ui";
import { consumeAuthFlash, redirectIfSignedIn } from "@/lib/server/auth";

/**
 * /learn/login — server-rendered (T14). A signed-in user goes to `next` or /learn (303).
 * The errors of a failed POST arrive in the flash cookie, read once here (T13).
 * Other languages: `pages/[lang]/learn/login.astro`.
 */
export const prerender = false;

const signedIn = redirectIfSignedIn(Astro);
if (signedIn) return signedIn;
const flash = consumeAuthFlash(Astro.cookies, "login");
---

<AuthForm lang={defaultLang} page="login" flash={flash} />
