---
import ExercisePage from "@/components/learn/ExercisePage.astro";
import { defaultLang } from "@/i18n/ui";
import { loadExercisePage, requireSignedIn } from "../_exercises";

/**
 * /learn/exercise/[id] — server-rendered (T14), private: without a session, 303 to the login
 * page with `?next=` back here. 404 for an unknown id, 500 if the database fails.
 * Other languages: `pages/[lang]/learn/exercise/[id].astro`.
 */
export const prerender = false;

const user = requireSignedIn(Astro);
if (user instanceof Response) return user;
const state = await loadExercisePage(Astro.locals.supabase, user, Astro.params.id, defaultLang, Astro.response);
---

<ExercisePage lang={defaultLang} state={state} />
