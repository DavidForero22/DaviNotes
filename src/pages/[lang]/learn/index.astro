---
import LearnHome from "@/components/learn/LearnHome.astro";
import { defaultLang } from "@/i18n/ui";
import { isLang } from "@/i18n/utils";
import type { ExerciseDTO } from "@/types/api";
import { loadExerciseList } from "../../learn/_exercises";

/**
 * /es/learn, /fr/learn — the learning area in every language except the default one, which
 * lives at /learn (`pages/learn/index.astro`). Server-rendered (T14): `[lang]` is validated
 * here (404 otherwise). The static "learn" segment takes priority over the docs catch-all.
 */
export const prerender = false;

const { lang } = Astro.params;
if (!isLang(lang) || lang === defaultLang) return new Response(null, { status: 404 });

let exercises: ExerciseDTO[] | null = null;
let loadError = false;
if (Astro.locals.user) {
	try {
		exercises = await loadExerciseList(Astro.locals.supabase, lang);
	} catch (error) {
		console.error("[learn] could not list the exercises", error);
		loadError = true;
	}
}
---

<LearnHome lang={lang} exercises={exercises} loadError={loadError} />
