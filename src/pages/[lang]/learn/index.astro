---
import LearnHome from "@/components/learn/LearnHome.astro";
import { defaultLang } from "@/i18n/ui";
import { isLang } from "@/i18n/utils";
import { loadLearnHome } from "../../learn/_exercises";

/**
 * /es/learn, /fr/learn — the learning area in every language except the default one, which
 * lives at /learn (`pages/learn/index.astro`). Server-rendered (T14): `[lang]` is validated
 * here (404 otherwise). The static "learn" segment takes priority over the docs catch-all.
 */
export const prerender = false;

const { lang } = Astro.params;
if (!isLang(lang) || lang === defaultLang) return new Response(null, { status: 404 });

const data = await loadLearnHome(Astro.locals.supabase, Astro.locals.user, lang);
---

<LearnHome lang={lang} {...data} />
