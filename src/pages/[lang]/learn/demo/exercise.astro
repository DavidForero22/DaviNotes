---
import type { GetStaticPaths } from "astro";
import ExerciseDemoPage from "@/components/learn/ExerciseDemoPage.astro";
import { defaultLang, type Lang } from "@/i18n/ui";
import { langs } from "@/i18n/utils";

/**
 * /es/learn/demo/exercise, /fr/learn/demo/exercise — the exercise demo in every language
 * except the default one (`pages/learn/demo/exercise.astro`).
 */
export const getStaticPaths = (() =>
	langs.filter((lang) => lang !== defaultLang).map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
---

<ExerciseDemoPage lang={lang} />
