---
import { ClientRouter } from "astro:transitions";
import AlternateLinks from "@/components/shared/AlternateLinks.astro";
import Footer from "@/components/shared/Footer.astro";
import LanguagePicker from "@/components/shared/LanguagePicker.astro";
import ModeSwitch from "@/components/shared/ModeSwitch.astro";
import AccountMenu from "@/components/learn/AccountMenu.astro";
import type { ProfileSnapshot } from "@/components/learn/exercise-ui";
import { getProfile } from "@/lib/server/progress";
import "@/styles/global.css";
import "@/styles/learn.css";
import type { Lang } from "@/i18n/ui";
import { localizePath, useTranslations } from "@/i18n/utils";

interface Props {
	title: string;
	lang: Lang;
	description: string;
	/** Keeps placeholder pages out of search results while links are still followed. */
	noindex?: boolean;
	/**
	 * Balance for the account menu when the page already loaded it. Omitted: the layout reads
	 * it for the signed-in user. Learn pages are server-rendered (T14), so `locals` has the session.
	 */
	profile?: ProfileSnapshot | null;
}

const { title, lang, description, noindex = false } = Astro.props;
const user = Astro.locals.user;
let profile: ProfileSnapshot | null = Astro.props.profile ?? null;
if (user && Astro.props.profile === undefined) {
	try {
		profile = await getProfile(Astro.locals.supabase, user);
	} catch (error) {
		// The menu still works without numbers (sign out is always there)
		console.error("[learn] could not read the profile for the header", error);
	}
}
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<AlternateLinks />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class="learn">
		<a href="#main-content" class="skip-link">{t("a11y.skipToContent")}</a>
		{/* Same dotted grid as the home page, so both areas read as one site */}
		<div class="background-grid"></div>

		{/* Unlike the docs, the header is a top-level landmark (banner), not part of <main> */}
		<header class="learn-header">
			<a href={localizePath("/learn/", lang)} class="learn-brand">Davi<span>Learn</span></a>
			<div class="learn-header-end">
				<ModeSwitch lang={lang} mode="learn" />
				<LanguagePicker lang={lang} />
				{/* Last in the DOM: brand, mode switch, language, account (guide account-a11y §2.4) */}
				<AccountMenu lang={lang} user={user} profile={profile} />
			</div>
		</header>

		<main id="main-content" tabindex="-1" class="learn-main">
			<slot />
		</main>

		<Footer lang={lang} />
	</body>
</html>
