---
import DocsLayout from "./DocInfoLayout.astro";
import InfoBox from "../components/InfoBox.astro";
import DocSearch from "../components/DocSearch.astro";
import DifficultyBadge from "../components/DifficultyBadge.astro";
import { INSTALLATION_GUIDE_SLUG, type LanguageItem } from "../data/languages";
import { frameworks } from "../data/frameworks";
import type { Lang } from "../i18n/ui";
import { pick, useTranslations } from "../i18n/utils";
import { getFrameworksForLanguage, getTextColorForBackground, languageHref } from "../utils/utils";

/**
 * Defines the essential configuration properties required to render the landing page.
 * It receives the language metadata from `languages.ts` (texts, colors and concepts) and the language the visitor is reading in.
 */
interface Props {
	item: LanguageItem;
	lang: Lang;
}

const { item, lang } = Astro.props;
const t = useTranslations(lang);

const color = item.theme.color;
const colorDark = item.theme.dark;
const btnTextColor = getTextColorForBackground(color);

/**
 * The translated title contains a `{lang}` placeholder (e.g. "Apuntes de {lang}").
 * It is split around the placeholder so the language name can be highlighted wherever it appears.
 */
const [titleBefore, titleAfter] = t("index.title").split("{lang}");

const installLink = languageHref(item, lang, INSTALLATION_GUIDE_SLUG);
const itemFrameworks = getFrameworksForLanguage(frameworks, item.slug);
---

<DocsLayout title={item.title} lang={lang}>
	<div class="landing-container">
		<h1 class="title">{titleBefore}<span class="text-highlight">{item.title}</span>{titleAfter}</h1>
		<p class="intro">{pick(item.intro, lang)}</p>

		<InfoBox
			lang={lang}
			difficulty={item.difficulty}
			prerequisites={item.prerequisites}
		/>

		<DocSearch item={item} lang={lang} />

		<hr class="divider" />

		<section>
			<h2>{t("index.keyConcepts")}</h2>
			<ul class="topic-list">
				{
					/* Index will be used in doc-layout.css for calculing the delay time in its animation */
					item.concepts.map((concept, index) => (
						<li style={`--i: ${index}`}>
							<a href={languageHref(item, lang, concept.slug)}>
								<h3>{pick(concept.title, lang)}</h3>
								<p>{pick(concept.desc, lang)}</p>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		{
			itemFrameworks.length > 0 && (
				<>
					<hr class="divider" />

					<section id="frameworks">
						<h2>{t("index.frameworks")}</h2>
						<p class="frameworks-intro">{t("index.frameworksIntro", { lang: item.title })}</p>

						<div class="framework-list">
							{itemFrameworks.map((framework, index) => (
								<details class="framework-item" style={`--i: ${index}`}>
									<summary>
										<div class="framework-summary-main">
											<h3>{framework.name}</h3>
											<p>{pick(framework.desc, lang)}</p>
										</div>
										<div class="framework-summary-meta">
											<DifficultyBadge lang={lang} difficulty={framework.difficulty} />
											<svg
												class="chevron"
												aria-hidden="true"
												xmlns="http://www.w3.org/2000/svg"
												width="18"
												height="18"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<polyline points="6 9 12 15 18 9" />
											</svg>
										</div>
									</summary>

									<div class="framework-concepts">
										<p class="framework-concepts-label">{t("index.frameworkConcepts")}</p>
										<ul class="topic-list">
											{framework.concepts.map((concept, conceptIndex) => (
												<li style={`--i: ${conceptIndex}`}>
													<a href={languageHref(item, lang, `${framework.slug}/${concept.slug}`)}>
														<h3>{pick(concept.title, lang)}</h3>
														<p>{pick(concept.desc, lang)}</p>
													</a>
												</li>
											))}
										</ul>
									</div>
								</details>
							))}
						</div>
					</section>
				</>
			)
		}

		<hr class="divider" />

		<section class="install-section">
			<div class="cta-container">
				<h2>{t("index.ctaTitle")}</h2>
				<p>{t("index.ctaText")}</p>

				<a
					href={installLink}
					class="install-btn"
					title={t("index.installTitle", { lang: item.title })}
				>
					{t("index.installGuide")} <span>&rarr;</span>
				</a>
			</div>
		</section>
	</div>
</DocsLayout>

<style
	define:vars={{
		themeColor: color,
		themeColorDark: colorDark,
		themeTextColor: btnTextColor,
	}}
>
	/*
    Utilizes Astro's define:vars directive to pass server-side JavaScript variables into the CSS scope.
    This creates dynamic CSS custom properties based on the props.
  */

	.text-highlight {
		color: var(--themeColor);
	}

	.topic-list a:hover {
		border-color: var(--themeColor);
	}

	.frameworks-intro {
		color: #a1a1aa;
		margin-top: -0.5rem;
		margin-bottom: 1.5rem;
	}

	.framework-list {
		display: grid;
		gap: 1rem;
	}

	.framework-item {
		background: #1e2127;
		border: 1px solid rgba(255, 255, 255, 0.05);
		border-radius: 8px;
		opacity: 0;
		animation: fadeInUp 0.6s ease-out forwards;
		animation-delay: calc(var(--i) * 0.1s);
	}

	.framework-item[open] {
		border-color: var(--themeColor);
	}

	.framework-item summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.25rem 1.5rem;
		cursor: pointer;
		list-style: none;
	}

	.framework-item summary::-webkit-details-marker {
		display: none;
	}

	.framework-summary-main h3 {
		margin: 0 0 0.35rem 0;
		color: white;
	}

	.framework-summary-main p {
		margin: 0;
		color: #888;
		font-size: 0.9rem;
	}

	.framework-summary-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-shrink: 0;
	}

	.chevron {
		color: #888;
		transition: transform 0.2s ease;
	}

	.framework-item[open] .chevron {
		color: var(--themeColor);
		transform: rotate(180deg);
	}

	.framework-concepts {
		padding: 0 1.5rem 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		padding-top: 1.5rem;
		margin-top: -0.25rem;
	}

	.framework-concepts-label {
		margin: 0 0 0.75rem;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #666;
	}

	.framework-concepts .topic-list {
		gap: 0.75rem;
	}

	.framework-concepts .topic-list a {
		padding: 1rem 1.25rem;
		background: #0d0f14;
	}

	.install-btn {
		background-color: var(--themeColor);
		color: var(--themeTextColor);
	}

	.install-btn:hover {
		background-color: var(--themeColorDark);
	}
</style>

<script>
	/**
	 * Animates the open/close of each `<details class="framework-item">` row, since native
	 * `<details>` toggling has no transition of its own. Intercepts the click on `<summary>`,
	 * runs a height animation with the Web Animations API, and only flips the `open` attribute
	 * once it finishes (closing) or right before it starts (opening), so CSS driven by `[open]`
	 * (border color, chevron rotation) stays in sync with what is visually happening.
	 */
	function setupFrameworkAccordions() {
		document.querySelectorAll<HTMLDetailsElement>(".framework-item").forEach((details) => {
			if (details.dataset.animated) return;
			details.dataset.animated = "true";

			const summary = details.querySelector("summary");
			const content = details.querySelector<HTMLElement>(".framework-concepts");
			if (!summary || !content) return;

			let animation: Animation | null = null;
			let isClosing = false;
			let isExpanding = false;

			summary.addEventListener("click", (event) => {
				event.preventDefault();
				details.style.overflow = "hidden";

				if (isClosing || !details.open) {
					open();
				} else if (isExpanding || details.open) {
					shrink();
				}
			});

			function shrink() {
				isClosing = true;
				const startHeight = `${details.offsetHeight}px`;
				const endHeight = `${summary!.offsetHeight}px`;

				animation?.cancel();
				animation = details.animate({ height: [startHeight, endHeight] }, { duration: 250, easing: "ease-out" });
				animation.onfinish = () => onAnimationFinish(false);
				animation.oncancel = () => (isClosing = false);
			}

			function open() {
				details.style.height = `${details.offsetHeight}px`;
				details.open = true;
				requestAnimationFrame(expand);
			}

			function expand() {
				isExpanding = true;
				const startHeight = `${details.offsetHeight}px`;
				const endHeight = `${summary!.offsetHeight + content!.offsetHeight}px`;

				animation?.cancel();
				animation = details.animate({ height: [startHeight, endHeight] }, { duration: 250, easing: "ease-out" });
				animation.onfinish = () => onAnimationFinish(true);
				animation.oncancel = () => (isExpanding = false);
			}

			function onAnimationFinish(isOpen: boolean) {
				details.open = isOpen;
				animation = null;
				isClosing = false;
				isExpanding = false;
				details.style.height = details.style.overflow = "";
			}
		});
	}

	document.addEventListener("astro:page-load", setupFrameworkAccordions);
</script>
