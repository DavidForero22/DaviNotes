---
import DocsLayout from "./DocInfoLayout.astro";
import InfoBox from "../components/InfoBox.astro";
import { INSTALLATION_GUIDE_SLUG, type LanguageItem } from "../data/languages";
import type { Lang } from "../i18n/ui";
import { pick, useTranslations } from "../i18n/utils";
import { getTextColorForBackground, languageHref } from "../utils/utils";

/**
 * Defines the essential configuration properties required to render the landing page.
 * It receives the language metadata from `languages.ts` (texts, colors and concepts) and the language the visitor is reading in.
 */
interface Props {
	item: LanguageItem;
	lang: Lang;
}

const { item, lang } = Astro.props;
const t = useTranslations(lang);

const color = item.theme.color;
const colorDark = item.theme.dark;
const btnTextColor = getTextColorForBackground(color);

/**
 * The translated title contains a `{lang}` placeholder (e.g. "Apuntes de {lang}").
 * It is split around the placeholder so the language name can be highlighted wherever it appears.
 */
const [titleBefore, titleAfter] = t("index.title").split("{lang}");

const installLink = languageHref(item, lang, INSTALLATION_GUIDE_SLUG);
---

<DocsLayout title={item.title} lang={lang}>
	<div class="landing-container">
		<h1 class="title">{titleBefore}<span class="text-highlight">{item.title}</span>{titleAfter}</h1>
		<p class="intro">{pick(item.intro, lang)}</p>

		<InfoBox
			lang={lang}
			difficulty={item.difficulty}
			prerequisites={item.prerequisites}
		/>

		<hr class="divider" />

		<section>
			<h2>{t("index.keyConcepts")}</h2>
			<ul class="topic-list">
				{
					/* Index will be used in doc-layout.css for calculing the delay time in its animation */
					item.concepts.map((concept, index) => (
						<li style={`--i: ${index}`}>
							<a href={languageHref(item, lang, concept.slug)}>
								<h3>{pick(concept.title, lang)}</h3>
								<p>{pick(concept.desc, lang)}</p>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<hr class="divider" />

		<section class="install-section">
			<div class="cta-container">
				<h2>{t("index.ctaTitle")}</h2>
				<p>{t("index.ctaText")}</p>

				<a
					href={installLink}
					class="install-btn"
					title={t("index.installTitle", { lang: item.title })}
				>
					{t("index.installGuide")} <span>&rarr;</span>
				</a>
			</div>
		</section>
	</div>
</DocsLayout>

<style
	define:vars={{
		themeColor: color,
		themeColorDark: colorDark,
		themeTextColor: btnTextColor,
	}}
>
	/*
    Utilizes Astro's define:vars directive to pass server-side JavaScript variables into the CSS scope.
    This creates dynamic CSS custom properties based on the props.
  */

	.text-highlight {
		color: var(--themeColor);
	}

	.topic-list a:hover {
		border-color: var(--themeColor);
	}

	.install-btn {
		background-color: var(--themeColor);
		color: var(--themeTextColor);
	}

	.install-btn:hover {
		background-color: var(--themeColorDark);
	}
</style>
